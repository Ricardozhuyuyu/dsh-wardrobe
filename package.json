{
  "name": "dsh-wardrobe",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "description": "衣橱插件：系列/套浏览、图片分类、私密相册、字段明细、标签检索、筛选与随机、穿着记录、故事时间线",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "data/*.json",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "keywords": [
    "deepseek-harness",
    "plugin",
    "wardrobe",
    "gallery"
  ]
}
